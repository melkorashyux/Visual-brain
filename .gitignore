# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# local sqlite db + uploaded screenshots
/data/visual-brain.db
/data/visual-brain.db-*
/data/uploads/
/data/exports/

# per-install settings (holds the Anthropic API key)
/data/settings.json

# electron packaging output
/release/
/electron/node_modules/

# typescript
*.tsbuildinfo
next-env.d.ts
